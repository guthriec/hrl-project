<mujoco model="point">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.01" integrator="RK4"/>
  
  <worldbody>
    <body name="torso" pos="0 0 0">
      <geom name="pointbody" type="sphere" size="0.1" rgba="0.8 0.2 0.2 1" mass="1.0"/>
      <joint name="x" type="slide" pos="0 0 0" axis="1 0 0" range="-50 50" limited="true"/>
      <joint name="y" type="slide" pos="0 0 0" axis="0 1 0" range="-50 50" limited="true"/>
    </body>
  </worldbody>
  
  <actuator>
    <motor joint="x" ctrlrange="-1.0 1.0" ctrllimited="true" gear="10"/>
    <motor joint="y" ctrlrange="-1.0 1.0" ctrllimited="true" gear="10"/>
  </actuator>
</mujoco>